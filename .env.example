# Copy to .env for `docker compose up`.
# Local `uv run` commands need `uv run --env-file .env ...`.
# Every value below is a development value. Never reuse these in a deployment.

# PostgreSQL bootstrap superuser. It owns the database and the olist schema,
# and the Olist loader connects as this user.
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard-dev-postgres
POSTGRES_DB=switchboard

# Application role: platform tables only, no access to the olist schema.
SWITCHBOARD_APP_DB_PASSWORD=switchboard-dev-app

# Tool server role: SELECT on olist, INSERT on tool_audit, nothing else.
SWITCHBOARD_TOOLS_DB_PASSWORD=switchboard-dev-tools

# Host-side URLs. Compose builds its own URLs for containers; these are for
# `uv run switchboard ...` and for integration tests.
SWITCHBOARD_DATABASE_ADMIN_URL=postgresql://switchboard:switchboard-dev-postgres@localhost:5432/switchboard
SWITCHBOARD_TOOLS_DATABASE_URL=postgresql://switchboard_tools:switchboard-dev-tools@localhost:5432/switchboard
SWITCHBOARD_DATABASE_URL=postgresql://switchboard_app:switchboard-dev-app@localhost:5432/switchboard

# MCP tool server as seen from the host (compose sets its own internal URL).
MCP_OLIST_URL=http://localhost:8001
MCP_OLIST_PORT=8001
# /health probes this base URL; the api container gets http://mcp-olist:8001.
SWITCHBOARD_TOOLS_URL=http://localhost:8001
SWITCHBOARD_TENANTS_FILE=config/tenants.yaml

# Span exporter for the API and the MCP server (tracing.exporter in
# config/platform.yaml): postgres writes to public.spans (default), otlp sends
# the same spans to a collector, none leaves the OpenTelemetry API a no-op.
# The DSN comes from the role URL above, so the API uses switchboard_app and
# the server uses switchboard_tools. Set otlp only while the tracing profile is
# up; see the README for the one-line switch and http://localhost:16686.
SWITCHBOARD_TRACING_EXPORTER=postgres

# OTLP/HTTP collector for host-side commands when the exporter is otlp.
# Compose passes http://jaeger:4318 to the containers for the tracing profile,
# because localhost inside a container is the container itself.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Signs run tokens between the API and the MCP server (ADR 0014).
# Must be at least 32 bytes; compose and both services refuse to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SWITCHBOARD_RUN_TOKEN_SECRET=

# LM Studio (Bionic) on the host. Host-side commands and the eval runner use
# localhost; the api container overrides this with host.docker.internal.
# Port 1234 falls inside a Windows excluded port range on this machine, so the
# local server is started with `lms server start --port 18080 --bind 0.0.0.0`.
LMSTUDIO_BASE_URL=http://localhost:18080/v1
LMSTUDIO_MODEL=qwen3-8b
LMSTUDIO_EMBEDDING_MODEL=bge-m3

# DeepSeek API key for the paid OpenAI-compatible provider in
# config/providers.yaml. Leave it empty for local-only use: the config still
# loads and no DeepSeek call is made, but a tenant or eval that selects the
# deepseek provider fails at startup with a named error before any request.
# Get a key from https://platform.deepseek.com/.
DEEPSEEK_API_KEY=
