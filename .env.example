# Copy to .env for `docker compose up`.
# Local `uv run` commands need `uv run --env-file .env ...`.
# Every value below is a development value. Never reuse these in a deployment.

# PostgreSQL bootstrap superuser. It owns the database and the olist schema,
# and the Olist loader connects as this user.
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard-dev-postgres
POSTGRES_DB=switchboard

# Application role: platform tables only, no access to the olist schema.
SWITCHBOARD_APP_DB_PASSWORD=switchboard-dev-app

# Tool server role: SELECT on olist, INSERT on tool_audit, nothing else.
SWITCHBOARD_TOOLS_DB_PASSWORD=switchboard-dev-tools

# Signs run tokens between the API and the MCP server (ADR 0014).
# Must be at least 32 bytes; compose and both services refuse to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SWITCHBOARD_RUN_TOKEN_SECRET=

# LM Studio (Bionic) on the host, seen from containers through
# host.docker.internal. Port 1234 falls inside a Windows excluded port range on
# this machine, so the local server is started with `lms server start --port
# 18080 --bind 0.0.0.0`.
LMSTUDIO_BASE_URL=http://host.docker.internal:18080/v1
LMSTUDIO_MODEL=qwen3-8b
LMSTUDIO_EMBEDDING_MODEL=bge-m3
