{
  "name": "switchboard-mcp-reviews",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only Olist review tools exposed over MCP (T3.08)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
